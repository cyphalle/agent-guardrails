#!/usr/bin/env bash
# bin/unlock: open a tier-3 window ahead of time, from a real terminal only.
set -euo pipefail

source "$(cd "$(dirname "$0")/.." && pwd)/hooks/lib/common.sh"

SCOPE=""
DURATION="30m"

usage() {
  cat <<EOF
Usage: unlock --scope <scope> [--duration <duration>]

  <scope>     A scope from your rules/*.json, or 'all'.
  <duration>  5m, 30m, 1h, 2h... Capped at 24h. 'all' is capped at 1h; any db-* scope and the
              locked scopes (guard-config, guard-misconfigured) at 30m. 'all' never covers a
              locked scope.

You rarely need this: in a supervised session, the first yes opens the window by itself.
Use it to open a window before a release or a diagnostic pass. Run it from your own terminal,
not from inside a Claude Code session.
EOF
  exit 1
}

# Two checks, because one is not enough. An agent's Bash tool has no TTY on stdin, but a
# pseudo-terminal is one `script` call away, so the TTY check alone does not keep this command
# out of an agent's reach. The second check refuses any unlock that has a Claude Code process
# among its ancestors. Neither check stops a process that first detaches from its parent (a
# double fork, setsid); the README lists that limit.
if [[ ! -t 0 ]]; then
  echo "ERROR: unlock requires an interactive terminal. Run it yourself, not from an agent." >&2
  exit 2
fi
CHAIN=$(guard_chain) || { echo "ERROR: unlock cannot read the process table." >&2; exit 2; }
if awk '$3 == 1 { found = 1 } END { exit !found }' <<< "$CHAIN"; then
  echo "ERROR: unlock refuses to run under a Claude Code process. Run it from your own terminal." >&2
  exit 2
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --scope)    SCOPE="${2:-}"; shift 2;;
    --duration) DURATION="${2:-}"; shift 2;;
    -h|--help)  usage;;
    *)          echo "Unknown arg: $1" >&2; usage;;
  esac
done

[[ -z "$SCOPE" ]] && { echo "ERROR: --scope required" >&2; usage; }
[[ "$SCOPE" =~ ^[A-Za-z0-9_.:-]+$ ]] || { echo "ERROR: bad scope name '$SCOPE'" >&2; exit 1; }

case "$DURATION" in
  *s) DUR_SEC=${DURATION%s};;
  *m) DUR_SEC=$(( ${DURATION%m} * 60 ));;
  *h) DUR_SEC=$(( ${DURATION%h} * 3600 ));;
  *)  echo "ERROR: bad duration format '$DURATION'" >&2; exit 1;;
esac
[[ "$DUR_SEC" =~ ^[0-9]+$ && "$DUR_SEC" -gt 0 ]] || { echo "ERROR: bad duration '$DURATION'" >&2; exit 1; }

if [[ "$DUR_SEC" -gt "$GUARD_MAX_WINDOW" ]]; then DUR_SEC=$GUARD_MAX_WINDOW; fi
if [[ "$SCOPE" == "all" && "$DUR_SEC" -gt 3600 ]]; then
  DUR_SEC=3600
  echo "[unlock] 'all' capped to 1h"
fi
if [[ ( "$SCOPE" == db-* || " $GUARD_LOCKED_SCOPES " == *" $SCOPE "* ) && "$DUR_SEC" -gt 1800 ]]; then
  DUR_SEC=1800
  echo "[unlock] '$SCOPE' capped to 30m"
fi

guard_add_window "$SCOPE" "$DUR_SEC" manual
echo "[unlock] scope=$SCOPE, $(( DUR_SEC / 60 ))m remaining"
